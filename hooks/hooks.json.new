{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/bootstrap.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "/file_editor|terminal/",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/hook-entry.sh guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "/file_editor|terminal/",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/hook-entry.sh audit",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/hook-entry.sh stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
