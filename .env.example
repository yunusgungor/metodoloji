# SkillOpt (openai_compatible backend) — local env
# Bu dosyayı .env olarak kopyala ve değerleri kendi local değerlerinle doldur.
# Gerçek .env dosyası .gitignore'da — asla commit'leme.

# Model backend
REFLACT_MODEL_BACKEND=openai_compatible

# OpenAI-uyumlu yerel LLM endpoint
OPENAI_COMPATIBLE_BASE_URL=http://localhost:20128/v1

# API anahtarı — sadece local kullanım için. Repo'ya koyma, paylaşma.
OPENAI_COMPATIBLE_API_KEY=sk-CHANGEME-local-XXXX

# Hedef model (SkillOpt hem optimizer hem target için aynısını kullanır)
OPENAI_COMPATIBLE_MODEL=kgw/kilo-auto/free
