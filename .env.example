# SkillOpt Environment Variables
# Copy to .env and fill in your API keys

# OpenAI (for optimizer model)
OPENAI_API_KEY=sk-...

# Azure OpenAI (if using Azure backend)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic (for claude_chat backend)
# ANTHROPIC_API_KEY=sk-ant-...

# Backend selection: openai_chat | claude_chat | qwen_chat | minimax_chat
SKILLOPT_BACKEND=openai_chat

# Model selection
SKILLOPT_TARGET_MODEL=gpt-4o
SKILLOPT_OPTIMIZER_MODEL=gpt-4o
