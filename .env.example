# SkillOpt Environment Variables — OpenAI-compatible backend
# Copy to .env and fill in your API keys

# SkillOpt uses AZURE_OPENAI_* vars for openai_compatible mode
AZURE_OPENAI_AUTH_MODE=openai_compatible
AZURE_OPENAI_ENDPOINT=http://localhost:20128/v1
AZURE_OPENAI_API_KEY=sk-your-api-key-here
AZURE_OPENAI_API_VERSION=openai-compat

# Model selection
SKILLOPT_TARGET_MODEL=oc/mimo-v2.5-free
SKILLOPT_OPTIMIZER_MODEL=oc/mimo-v2.5-free
