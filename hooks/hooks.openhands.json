{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/bootstrap.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "/file_editor|terminal/",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/hook-entry.sh guard openhands",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "/terminal/",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/hook-entry.sh quality openhands",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "/terminal/",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/hook-entry.sh deploy openhands",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "/file_editor|terminal/",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/hook-entry.sh audit openhands",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.openhands/plugins/installed/metodoloji/hooks/scripts/hook-entry.sh stop openhands",
            "timeout": 15
          }
        ]
      }
    ]
  }
}