__pycache__/
*.pyc
.pytest_cache/
.metodoloji/logs/
.metodoloji/blackboard.json
.metodoloji/blackboard.json.lock
.metodoloji/blackboard.json.*.tmp
# Methodology state anywhere in the tree (e.g. test residue under hooks/):
# only root-level state files above are tracked-adjacent; nested trees are
# always local-only.
**/.metodoloji/logs/
**/.metodoloji/blackboard.json
**/.metodoloji/blackboard.json.lock
**/.metodoloji/blackboard.json.*.tmp
**/.metodoloji/canvas.json
# Runtime lock sidecar files created while verifying experiment records
# (fail-open advisory locks); never track them.
docs/experiments/*.lock
_generated_splits/
.env

# SkillOpt training outputs
outputs/

# Personal config layer in the output-local project layer (never commit)
bmad-output/config.user.toml
